# Copy to .env (never commit .env)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
# Add your LAN IP origin here when testing on a physical phone / Expo web
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
DATABASE_URL=postgres://medibook:medibook@127.0.0.1:5432/medibook
# Razorpay TEST-mode credentials (https://dashboard.razorpay.com -> Test Mode -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BOOKING_HOLD_MINUTES=15
CANCELLATION_CUTOFF_HOURS=4
